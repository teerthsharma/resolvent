# Lean build artefacts — mathlib toolchain, hundreds of MB, fully reproducible
lean/.lake/
lean/build/
*.olean
*.ilean
*.trace

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Measurement locks are process state, not evidence.
# The JOURNALS (results/*.jsonl) ARE evidence and ARE committed.
results/*.lock

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Third-party benchmark corpora — NOT redistributed here.
# COGS (Kim & Linzen 2020), SCAN (Lake & Baroni 2018) and TinyStories
# (Eldan & Li 2023) carry their own licences and are fetchable upstream.
# See data/README.md for provenance and exact fetch commands.
data/*.tsv
data/*.txt

# pytest-benchmark output. Regenerated on every run.
.benchmarks/

# Python packaging artefacts. `ceq/` is packaged for the Hub, so an editable
# install drops these in.
*.egg-info/
/build/
/dist/

# scale/planted.py writes this while a source mutation is live and removes it on
# revert. It must never be committed: a stale sentinel in the repo would make
# assert_no_stale_plant() raise for every clone, forever.
results/.planted_mutation.json

# the code snapshot is REGENERATED by `git archive` at each push -- committing
# it would nest every snapshot inside the next one and double the tree each time
kaggle/snapshot/repo/
results/kaggle_v17k_output/
results/v17k_watch.log
results/.v17k_watch.pid

# Test-run event ledger. Process state, regenerated by tests/cameron/conftest.py.
house-events.jsonl

# Scratch work-in-progress, not part of the shipped record: JEPA experiment tree
# (checkpoints, HF weight blobs, Kaggle kernel metadata carrying account slugs),
# a stray Windows `> nul` artefact, and status/plan docs that never landed in
# the canon (docs/canon/ or MISTAKES.md).
# ceqjepa/ is the JEPA experiment tree. The attention-operator modules the published
# record cites are tracked one by one (`git ls-files ceqjepa/`); the rest stays local.
# Never shipped: trained weights, the duplicated package under space/, Kaggle
# metadata carrying a private account slug, and run exhaust.
ceqjepa/**/*.pt
ceqjepa/**/*.pt.last
ceqjepa/**/*.safetensors
ceqjepa/space/
ceqjepa/kaggle/**/kernel-metadata.json
ceqjepa/kaggle/LAUNCH.md
ceqjepa/kaggle/**/out/
ceqjepa/**/__pycache__/
ceqjepa_checkpoint.pt*
nul.tmp
NORTHSTAR_REPORT.md
workdonecrazynew.md
docs/ARCHITECTURE_OPTIONS.md
docs/CEQ_JEPA_PLAN.md

# MkDocs build output; the site is deployed to the gh-pages branch by `mkdocs gh-deploy`.
site/

# session exhaust: collect dumps, coverage artefacts, one-off run results
.coverage_two
bounded_run_result.json
errors_list.txt
full_collect.txt
pytest_collect.txt
